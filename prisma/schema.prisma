// Prisma schema — Portal de Dados Orçamentários (SEPLAN-AC)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Dashboard/Tema (conceito de primeira classe) ----------
model Dashboard {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  colorTheme  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories Category[]
  entries    BudgetEntry[]
  imports    ImportBatch[]
}

// ---------- Taxonomia de categorias (por dashboard, hierárquica) ----------
model Category {
  id          String     @id @default(cuid())
  dashboardId String
  dashboard   Dashboard  @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  name        String
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  entries     BudgetEntry[]

  @@unique([dashboardId, name, parentId])
}

// ---------- Linha de dado orçamentário ----------
model BudgetEntry {
  id          String    @id @default(cuid())
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  fiscalYear    Int
  fundingSource String?
  region        String?
  agency        String?
  /** Unidade gestora do órgão (quando a fonte detalha esse nível). */
  managementUnit String?
  program       String?
  action        String?
  description   String?

  valuePlanned   Decimal  @db.Decimal(18, 2)
  valueCommitted Decimal? @db.Decimal(18, 2)
  valueExecuted  Decimal? @db.Decimal(18, 2)
  /** Valor pago (quando a fonte distingue liquidado de pago). */
  valuePaid      Decimal? @db.Decimal(18, 2)

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])

  @@index([dashboardId, fiscalYear])
  @@index([dashboardId, categoryId])
}

// ---------- Auditoria de importações em massa ----------
model ImportBatch {
  id          String       @id @default(cuid())
  dashboardId String
  dashboard   Dashboard    @relation(fields: [dashboardId], references: [id])
  fileName    String
  status      ImportStatus @default(PENDING)
  totalRows   Int
  successRows Int          @default(0)
  errorRows   Int          @default(0)
  errorLog    Json?
  createdAt   DateTime     @default(now())
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id])
  entries     BudgetEntry[]
}

enum ImportStatus {
  PENDING
  VALIDATED
  COMMITTED
  FAILED
}

// ---------- Autenticação (Auth.js + Prisma adapter + Credentials) ----------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(EDITOR)
  /** Conta desativada perde o acesso, mas preserva a autoria dos registros e importações. */
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  /** Administrador que cadastrou esta conta. */
  createdById String?
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[] @relation("UserCreatedBy")

  accounts      Account[]
  sessions      Session[]
  budgetEntries BudgetEntry[]
  importBatches ImportBatch[]
}

enum UserRole {
  ADMIN
  EDITOR
}

// Exigido pelo @auth/prisma-adapter (mesmo usando apenas Credentials + JWT hoje),
// para manter compatibilidade caso um provedor OAuth seja adicionado depois.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
