# Banco de dados (Neon PostgreSQL) — copie a connection string do painel do Neon
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js — gere com: npx auth secret (ou `openssl rand -base64 32`)
AUTH_SECRET=""

# Primeiro administrador, criado por prisma/seed.ts. As contas dos demais servidores são
# cadastradas pela tela /admin/usuarios — não precisam de variável de ambiente.
SEED_ADMIN_EMAIL="admin@seplan.ac.gov.br"
SEED_ADMIN_PASSWORD=""
